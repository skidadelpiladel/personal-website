# Copy to .env and set real values — never commit .env
PORT=3001
NODE_ENV=development
SESSION_SECRET=change_this_to_a_long_random_string_at_least_32_chars
ADMIN_USERNAME=admin
# Generate hash with: node server/scripts/generate-hash.js your_password
ADMIN_PASSWORD_HASH=$2b$12$placeholder_hash_replace_me
# For local dev, httpOnly cookies are not Secure; set to production for HTTPS
COOKIE_SECURE=false
